<Window x:Class="InvoiceAiProcessor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InvoiceAiProcessor"
        mc:Ignorable="d"
        Title="發票 AI 處理器" Height="640" Width="1080">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="16" BorderThickness="1" CornerRadius="8" BorderBrush="#FFBFBFBF">
            <StackPanel>
                <TextBlock Text="模組狀態" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
                <TextBlock x:Name="StatusText"
                           TextWrapping="Wrap"
                           FontSize="14"
                           LineHeight="24" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Padding="16" BorderThickness="1" CornerRadius="8" BorderBrush="#FFBFBFBF">
            <StackPanel>
                <TextBlock Text="處理進度" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
                <TextBlock x:Name="ProgressText"
                           Text="尚未開始"
                           FontSize="14"
                           Margin="0,0,0,8" />
                <ProgressBar x:Name="ProcessingProgressBar"
                             Height="16"
                             Minimum="0"
                             Maximum="100"
                             Value="0"
                             Margin="0,0,0,8" />
                <TextBlock x:Name="ResultSummaryText"
                           Text=""
                           TextWrapping="Wrap"
                           FontSize="14"
                           LineHeight="22" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button x:Name="StartButton"
                    Content="開始處理"
                    Width="120"
                    Height="36"
                    Margin="0,0,12,0"
                    Click="StartButton_OnClick" />
            <Button x:Name="OpenFolderCButton"
                    Content="開啟Folder C"
                    Width="140"
                    Height="36"
                    Click="OpenFolderCButton_OnClick" />
        </StackPanel>
    </Grid>
</Window>
