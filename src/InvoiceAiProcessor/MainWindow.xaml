<Window x:Class="InvoiceAiProcessor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InvoiceAiProcessor"
        mc:Ignorable="d"
        Title="發票 AI 處理器" Height="640" Width="1080">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="16" BorderThickness="1" CornerRadius="8" BorderBrush="#FFBFBFBF">
            <StackPanel>
                <TextBlock Text="模組狀態" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
                <TextBlock x:Name="StatusText"
                           TextWrapping="Wrap"
                           FontSize="14"
                           LineHeight="24" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Padding="16" BorderThickness="1" CornerRadius="8" BorderBrush="#FFBFBFBF">
            <TabControl x:Name="MainTabs">
                <TabItem Header="手動知識回饋">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DataGrid x:Name="FeedbackGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  IsReadOnly="False"
                                  SelectionUnit="FullRow"
                                  RowHeight="32">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="核准" Width="70"
                                                        Binding="{Binding IsApproved, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridTextColumn Header="發票號碼" Width="120" Binding="{Binding InvoiceNumber}" IsReadOnly="True" />
                                <DataGridTextColumn Header="公司名稱" Width="160" Binding="{Binding CompanyName}" IsReadOnly="True" />
                                <DataGridTextColumn Header="品名" Width="220" Binding="{Binding ItemName}" IsReadOnly="True" />
                                <DataGridTextColumn Header="AI_可抵稅" Width="100" Binding="{Binding DeductibleStatus}" IsReadOnly="True" />
                                <DataGridTextColumn Header="AI_建議科目" Width="120" Binding="{Binding AccountingCategory}" IsReadOnly="True" />
                                <DataGridTextColumn Header="AI_信心度" Width="90" Binding="{Binding ConfidenceScoreDisplay}" IsReadOnly="True" />
                                <DataGridTextColumn Header="判定來源" Width="110" Binding="{Binding ResolvedByDisplay}" IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="2" Orientation="Vertical">
                            <Button x:Name="UpdateKnowledgeButton"
                                    Width="160"
                                    Height="36"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,8"
                                    Click="UpdateKnowledgeButton_Click"
                                    Content="更新知識庫" />
                            <TextBlock x:Name="FeedbackStatusText"
                                       TextWrapping="Wrap"
                                       FontSize="14"
                                       LineHeight="22" />
                        </StackPanel>
                    </Grid>
                </TabItem>
                <TabItem Header="訓練流程（免 CLI）">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="DatasetPathTextBox"
                                 Grid.Row="0"
                                 Grid.Column="0"
                                 IsReadOnly="True"
                                 Height="34"
                                 VerticalContentAlignment="Center"
                                 FontSize="13"
                                 Text="尚未選擇資料集" />
                        <Button x:Name="SelectDatasetButton"
                                Grid.Row="0"
                                Grid.Column="2"
                                Width="140"
                                Height="34"
                                Click="SelectDatasetButton_Click"
                                Content="選擇資料集(.xlsx)" />

                        <StackPanel Grid.Row="2"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="3"
                                    Orientation="Horizontal">
                            <Button x:Name="ValidateDatasetButton"
                                    Width="120"
                                    Height="34"
                                    Margin="0,0,8,0"
                                    Click="ValidateDatasetButton_Click"
                                    Content="1. 驗證資料集" />
                            <Button x:Name="TrainModelButton"
                                    Width="120"
                                    Height="34"
                                    Margin="0,0,8,0"
                                    Click="TrainModelButton_Click"
                                    Content="2. 執行訓練" />
                            <Button x:Name="EvaluateModelButton"
                                    Width="120"
                                    Height="34"
                                    Margin="0,0,8,0"
                                    Click="EvaluateModelButton_Click"
                                    Content="3. 產生評估" />
                            <Button x:Name="PublishModelButton"
                                    Width="120"
                                    Height="34"
                                    Click="PublishModelButton_Click"
                                    Content="4. 發布模型" />
                        </StackPanel>

                        <StackPanel Grid.Row="4"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="3"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="核准人："
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <TextBox x:Name="TrainingApproverTextBox"
                                     Width="220"
                                     Height="30"
                                     VerticalContentAlignment="Center" />
                        </StackPanel>

                        <TextBlock x:Name="TrainingStatusText"
                                   Grid.Row="6"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="3"
                                   TextWrapping="Wrap"
                                   FontSize="13"
                                   LineHeight="22" />
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>

        <TextBlock Grid.Row="4"
                   Text="提示：訓練流程先執行資料驗證，再進行訓練/評估，最後由核准人發布模型。"
                   FontSize="13"
                   Foreground="#FF4A4A4A" />
    </Grid>
</Window>
