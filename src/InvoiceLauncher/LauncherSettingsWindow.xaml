<Window x:Class="InvoiceLauncher.LauncherSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="主控台設定"
        Width="760"
        Height="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="模組名稱" VerticalAlignment="Center" Margin="0,0,12,10" />
                <TextBox x:Name="ModuleNameTextBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Height="32" Padding="8" Margin="0,0,0,10" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Folder A 路徑" VerticalAlignment="Center" Margin="0,0,12,10" />
                <TextBox x:Name="FolderAPathTextBox" Grid.Row="1" Grid.Column="1" Height="32" Padding="8" Margin="0,0,8,10" />
                <Button Grid.Row="1" Grid.Column="2" Content="選擇資料夾" Padding="12,6" Margin="0,0,0,10" Click="PickFolderAButton_Click" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Folder B 路徑" VerticalAlignment="Center" Margin="0,0,12,10" />
                <TextBox x:Name="FolderBPathTextBox" Grid.Row="2" Grid.Column="1" Height="32" Padding="8" Margin="0,0,8,10" />
                <Button Grid.Row="2" Grid.Column="2" Content="選擇資料夾" Padding="12,6" Margin="0,0,0,10" Click="PickFolderBButton_Click" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="下載器命名規則" VerticalAlignment="Center" Margin="0,0,12,10" />
                <TextBox x:Name="FileNamingRuleTextBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Height="32" Padding="8" Margin="0,0,0,10" />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="MOF 帳號" VerticalAlignment="Center" Margin="0,0,12,10" />
                <TextBox x:Name="MofAccountTextBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Height="32" Padding="8" Margin="0,0,0,10" />

                <TextBlock Grid.Row="5" Grid.Column="0" Text="下載模式" VerticalAlignment="Center" Margin="0,0,12,10" />
                <TextBox x:Name="InvoiceDownloadModeTextBox" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Height="32" Padding="8" Margin="0,0,0,10" />

                <TextBlock Grid.Row="6" Grid.Column="0" Text="官方 API Base URL" VerticalAlignment="Center" Margin="0,0,12,10" />
                <TextBox x:Name="OfficialApiBaseUrlTextBox" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Height="32" Padding="8" Margin="0,0,0,10" />

                <TextBlock Grid.Row="7" Grid.Column="0" Text="App ID" VerticalAlignment="Center" Margin="0,0,12,10" />
                <TextBox x:Name="OfficialApiAppIdTextBox" Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" Height="32" Padding="8" Margin="0,0,0,10" />

                <TextBlock Grid.Row="8" Grid.Column="0" Text="App Key" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBox x:Name="OfficialApiAppKeyTextBox" Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2" Height="32" Padding="8" />

                <TextBlock Grid.Row="9" Grid.Column="0" Text="Processor 命名規則" VerticalAlignment="Center" Margin="0,10,12,0" />
                <TextBox x:Name="ProcessorFileNamingRuleTextBox" Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="2" Height="32" Padding="8" Margin="0,10,0,0" />

                <TextBlock Grid.Row="10" Grid.Column="0" Text="Processor 知識庫檔案" VerticalAlignment="Center" Margin="0,10,12,0" />
                <TextBox x:Name="ProcessorKnowledgeRepositoryFileTextBox" Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="2" Height="32" Padding="8" Margin="0,10,0,0" />
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="取消" Padding="16,6" Margin="0,0,8,0" Click="CancelButton_Click" />
            <Button Content="儲存設定" Padding="16,6" Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>
