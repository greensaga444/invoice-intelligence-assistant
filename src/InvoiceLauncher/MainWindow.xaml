<Window x:Class="InvoiceLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InvoiceLauncher"
        mc:Ignorable="d"
        Title="發票智慧助理主控台" Height="680" Width="1024" MinHeight="620" MinWidth="900">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="14"
                Margin="0,0,0,12"
                BorderThickness="1"
                CornerRadius="8"
                BorderBrush="#FFBFBFBF"
                Background="#FFF9F9F9">
            <StackPanel>
                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left"
                               Text="主控台"
                               FontSize="24"
                               FontWeight="SemiBold" />
                    <Button x:Name="OpenSettingsButton"
                            DockPanel.Dock="Right"
                            Content="設定"
                            Padding="14,6"
                            Click="OpenSettingsButton_Click" />
                </DockPanel>
                <TextBlock Margin="0,8,0,0"
                           TextWrapping="Wrap"
                           FontSize="13"
                           LineHeight="22"
                           Text="可由此啟動完整流程（Downloader -> Processor），也可個別啟動模組。設定檔集中在根目錄 config，子模組獨立執行時不提供設定 UI。" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Padding="14"
                Margin="0,0,0,12"
                BorderThickness="1"
                CornerRadius="8"
                BorderBrush="#FFBFBF">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.ColumnSpan="4"
                           Margin="0,0,0,8"
                           Text="模組位置"
                           FontSize="18"
                           FontWeight="SemiBold" />

                <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="Downloader" />
                <TextBlock x:Name="DownloaderPathText"
                           Grid.Row="1"
                           Grid.Column="1"
                           Margin="0,0,12,0"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="DownloaderStatusText"
                           Grid.Row="1"
                           Grid.Column="2"
                           Margin="0,0,12,0"
                           VerticalAlignment="Center"
                           Foreground="#FF1A4D8F"
                           FontWeight="SemiBold" />
                <Button x:Name="OpenDownloaderFolderButton"
                        Grid.Row="1"
                        Grid.Column="3"
                        Content="開啟子資料夾"
                        Padding="12,6"
                        Click="OpenDownloaderFolderButton_Click" />

                <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="Processor" />
                <TextBlock x:Name="ProcessorPathText"
                           Grid.Row="2"
                           Grid.Column="1"
                           Margin="0,8,12,0"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="ProcessorStatusText"
                           Grid.Row="2"
                           Grid.Column="2"
                           Margin="0,8,12,0"
                           VerticalAlignment="Center"
                           Foreground="#FF1A4D8F"
                           FontWeight="SemiBold" />
                <Button x:Name="OpenProcessorFolderButton"
                        Grid.Row="2"
                        Grid.Column="3"
                        Margin="0,8,0,0"
                        Content="開啟子資料夾"
                        Padding="12,6"
                        Click="OpenProcessorFolderButton_Click" />

                <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Text="RAG 訓練（Processor）" />
                <TextBlock x:Name="TrainerPathText"
                           Grid.Row="3"
                           Grid.Column="1"
                           Margin="0,8,12,0"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="TrainerStatusText"
                           Grid.Row="3"
                           Grid.Column="2"
                           Margin="0,8,12,0"
                           VerticalAlignment="Center"
                           Foreground="#FF1A4D8F"
                           FontWeight="SemiBold" />
                <Button x:Name="OpenTrainerFolderButton"
                        Grid.Row="3"
                        Grid.Column="3"
                        Margin="0,8,0,0"
                        Content="開啟子資料夾"
                        Padding="12,6"
                        Click="OpenTrainerFolderButton_Click" />
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Padding="14"
                Margin="0,0,0,12"
                BorderThickness="1"
                CornerRadius="8"
                BorderBrush="#FFBFBFBF"
                Background="#FFF9F9F9">
            <StackPanel>
                <TextBlock Text="執行操作"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />
                <WrapPanel>
                    <Button x:Name="RunFullFlowButton"
                            Content="執行完整流程"
                            Padding="14,6"
                            Margin="0,0,8,0"
                            Click="RunFullFlowButton_Click" />
                    <Button x:Name="LaunchDownloaderButton"
                            Content="開啟 Downloader"
                            Padding="14,6"
                            Margin="0,0,8,0"
                            Click="LaunchDownloaderButton_Click" />
                    <Button x:Name="LaunchProcessorButton"
                            Content="開啟 Processor"
                            Padding="14,6"
                            Margin="0,0,8,0"
                            Click="LaunchProcessorButton_Click" />
                    <Button x:Name="LaunchTrainerButton"
                            Content="開啟 RAG 訓練"
                            Padding="14,6"
                            Margin="0,0,8,0"
                            Click="LaunchTrainerButton_Click" />
                    <Button x:Name="RefreshStatusButton"
                            Content="重新整理狀態"
                            Padding="14,6"
                            Click="RefreshStatusButton_Click" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="3"
                Padding="12"
                BorderThickness="1"
                CornerRadius="8"
                BorderBrush="#FFBFBFBF">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="執行記錄"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />

                <TextBox x:Name="ExecutionLogTextBox"
                         Grid.Row="1"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         FontFamily="Consolas"
                         FontSize="12" />
            </Grid>
        </Border>

        <TextBlock Grid.Row="4"
                   Margin="0,12,0,0"
                   FontSize="12"
                   Foreground="#FF666666"
                   Text="提示：部署結構應包含 downloader、processor、config 三個同層資料夾。" />
    </Grid>
</Window>